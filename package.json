{
  "name": "social-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run db:migrate:local && wrangler dev --port 8790 --var APP_ENV:development --var AI_PROVIDER:demo",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:headed": "playwright test --headed",
    "demo:record": "playwright test tests/e2e/record-user-flow.spec.ts --project=demo-recording",
    "e2e:prepare": "node scripts/prepare-e2e.mjs",
    "e2e:serve": "npm run build && npm run e2e:prepare && node scripts/serve-e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply social-studio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply social-studio-db --remote"
  },
  "dependencies": {
    "@lucide/vue": "^1.37.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
