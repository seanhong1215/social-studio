{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-studio-demo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-studio-demo-db",
      "database_id": "4a9dc3ef-11d8-46c2-bf5b-729b5b046c9b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "social-studio-demo-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTENT_QUEUE",
        "queue": "social-studio-demo-content"
      }
    ],
    "consumers": [
      {
        "queue": "social-studio-demo-content",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "social-studio-demo-content-dlq"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "AI_PROVIDER": "demo"
  }
}
